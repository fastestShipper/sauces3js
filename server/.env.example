# Configuracion del relay. Copiar a `server/.env` (ignorado por git) o exportar
# desde el systemd unit. NUNCA commitear valores reales.

# --- Login con Google (Privy) ---
# Solo hace falta el APP ID. La clave publica se lee del JWKS de Privy, que
# ademas sigue la rotacion de claves solo.
PRIVY_APP_ID=

# Opcional: sobreescribir el JWKS. Por defecto se deriva del app id:
#   https://auth.privy.io/api/v1/apps/<PRIVY_APP_ID>/jwks.json
# PRIVY_JWKS_URL=

# Opcional: pinear UNA sola clave publica (PEM SPKI, ES256) en vez del JWKS.
# OJO: Privy rota sus claves. Si pineas una, el dia que rote se caen los logins.
# PRIVY_VERIFICATION_KEY=

# El APP SECRET de Privy NO se usa aca. Verificar un token solo necesita la clave
# PUBLICA. El secret es para la API server-side de Privy; si no la llamas, no lo
# guardes en ningun lado.

# --- Migracion a "solo Google" ---
# Mientras esto no sea 0, las cuentas viejas siguen entrando con contrasena para
# poder atar su Google (mensaje `privylink`). Ponerlo en 0 cuando todos migraron.
AUTH_PASSWORD_ENABLED=1

# --- Cuenta dios (opcional; sin las tres, el camino queda deshabilitado) ---
GOD_USER=
GOD_PASS_SALT=
GOD_PASS_HASH=

# --- Puertos / almacenamiento ---
# SAUCES_PORT=8456
# SAUCES_HEALTH_PORT=8457
# SAUCES_STORE_PATH=./accounts.json
